// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // engineType "client" = no native Rust query engine (uses the WASM query
  // compiler + a driver adapter instead), so there is no libquery_engine
  // binary to bundle into Vercel's serverless functions. The client is driven
  // through @prisma/adapter-pg (see src/lib/prisma.ts).
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer on Neon) for the app at runtime.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection for `prisma migrate` (DDL needs a real session).
  directUrl = env("DIRECT_URL")
}

// A registered account. Distinct from Member: a User has login + owns/joins
// groups, while a Member is just a named slot inside one group's expenses.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  sessions            Session[]
  ownedGroups         Group[]              @relation("GroupOwner")
  memberships         GroupMember[]
  createdInvites      GroupInvite[]        @relation("InviteCreatedBy")
  claimedMembers      Member[]
  passwordResetTokens PasswordResetToken[]
  createdExpenses     Expense[]            @relation("ExpenseCreatedBy")
  createdPayments     Payment[]            @relation("PaymentCreatedBy")
}

// Opaque server-side session. `id` is the SHA-256 hex of the random token kept
// in the client cookie — nothing is signed, so no session secret is needed.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time "forgot password" link. Same shape as Session: `id` is the
// SHA-256 hash of the random token emailed to the user, so a DB leak can't
// be replayed as a working reset link. `usedAt` makes it single-use even
// under a race (checked + set inside one transaction in lib/auth.ts).
model PasswordResetToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

// Who can access a group, and at what level ("owner" | "member").
model GroupMember {
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// Shareable join link. Reusable until it expires or is revoked.
model GroupInvite {
  token       String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([groupId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Currency every balance in this group is expressed in. One of the codes in
  // src/lib/currencies.ts. Chosen at creation, not editable afterwards (that
  // would invalidate the per-expense rates below).
  baseCurrency String @default("RON")

  ownerId String
  owner   User   @relation("GroupOwner", fields: [ownerId], references: [id])

  members      Member[]
  groupMembers GroupMember[]
  invites      GroupInvite[]
  expenses     Expense[]
  payments     Payment[]
}

model Member {
  id      String @id @default(cuid())
  name    String
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Optionally links this slot to a real account (claimed via an invite).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  paidExpenses     Expense[]            @relation("PaidBy")
  shares           ExpenseParticipant[]
  paymentsSent     Payment[]            @relation("PaymentFrom")
  paymentsReceived Payment[]            @relation("PaymentTo")

  @@unique([groupId, userId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Int
  createdAt   DateTime @default(now())

  // Currency this expense was entered in (a code from src/lib/currencies.ts),
  // and the exchange rate to the group's base currency at entry time, stored
  // as "micros" = base units per 1 expense-currency unit * 1_000_000. When
  // currency == group.baseCurrency the rate is exactly 1_000_000.
  currency   String @default("RON")
  rateMicros Int    @default(1000000)

  // One of the slugs in src/lib/categories.ts, or null = uncategorised.
  category String?

  // How `amount` is divided among participants:
  //   EQUAL   — split equally (participant.weight ignored / all 1)
  //   EXACT   — participant.weight is the exact amount owed, in bani; sum == amount
  //   PERCENT — participant.weight is basis points (percent * 100); sum == 10000
  //   SHARES  — participant.weight is a whole share count (>= 1); amount is split
  //             proportionally to the shares, no fixed sum
  splitMode String @default("EQUAL")

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  paidById String
  paidBy   Member @relation("PaidBy", fields: [paidById], references: [id])

  // Who entered this expense. Null for rows created before creator tracking;
  // a plain member may only edit/delete their own, an owner may touch any.
  createdById String?
  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  participants ExpenseParticipant[]
}

model ExpenseParticipant {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Meaning depends on Expense.splitMode (see above). 1 for EQUAL.
  weight Int @default(1)

  @@id([expenseId, memberId])
}

// A real payment from one member to another (settling up). Recorded manually;
// it reduces the outstanding balance between the two members.
model Payment {
  id        String   @id @default(cuid())
  amount    Int // bani
  createdAt DateTime @default(now())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  fromId String
  from   Member @relation("PaymentFrom", fields: [fromId], references: [id], onDelete: Restrict)

  toId String
  to   Member @relation("PaymentTo", fields: [toId], references: [id], onDelete: Restrict)

  // Who recorded this payment. Same rule as Expense.createdById.
  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}
