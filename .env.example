# PostgreSQL connection strings.
#
# DATABASE_URL — used by the app at runtime. On Vercel this is the *pooled*
#   Neon URL (injected by the Neon integration). Locally, a plain Postgres URL.
# DIRECT_URL   — a direct, unpooled connection used only by `prisma migrate`.
#   On Vercel set this to Neon's unpooled URL. Locally it can equal DATABASE_URL.
#
# Local dev (Postgres via Docker — see README "Pornire locală"):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_splitter?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/expense_splitter?schema=public"

# Integration tests (npm test) use a separate throwaway database. Override if
# your local Postgres differs; CI sets this to its postgres service.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_splitter_test?schema=public"

# Password reset emails, sent via Resend's HTTP API (no SDK) — get a key at
# https://resend.com. Without RESEND_API_KEY, "forgot password" still works
# (a reset token is created) but the email silently fails to send — see
# src/lib/email.ts.
# RESEND_API_KEY="re_..."
# RESEND_FROM="onboarding@resend.dev"   # needs a verified domain to send to
                                         # anyone but your own Resend account

# Base URL used to build the link inside the reset email. Set this to the
# real deployed URL in production; defaults to localhost for dev.
# APP_ORIGIN="http://localhost:3000"
